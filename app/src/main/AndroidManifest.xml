<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.software.app_widgets" />
    <uses-feature android:name="android.software.live_wallpaper" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/SplashScreen"
        tools:targetApi="31">
        <activity
            android:name=".experiment.RadioExperimentActivity"
            android:exported="false"
            android:label="@string/title_activity_radio_experiment"
            android:theme="@style/Theme.WholesomeWare"/>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".wallpaper.KoloraFesztAnalogClockWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/kolora_feszt_analog_clock_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/kolora_feszt_analog_clock_wallpaper" />
        </service>
        <service
            android:name=".wallpaper.D20WallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/d20_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/d20_wallpaper" />
        </service>
        <service
            android:name=".wallpaper.TemplateWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/template_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/template_wallpaper" />
        </service>
        <service
            android:name=".wallpaper.HelkaFreeFlightDiveWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/helka_free_flight_dive_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/helka_free_flight_dive_wallpaper" />
        </service>
        <service
            android:name=".wallpaper.LighthouseWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/lighthouse_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/lighthouse_wallpaper" />
        </service>
        <service
            android:name=".wallpaper.SkeletonSwingWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/skeleton_swing_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/skeleton_swing_wallpaper" />
        </service>

        <receiver
            android:name=".widget.KoloraFesztAnalogClockWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kolora_feszt_analog_clock_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DartsHelperWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/darts_helper_widget_info" />
        </receiver>

        <service
            android:name=".service.RadioService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>